# Expo Go Development Credentials
# Copiar este archivo a .env.local y ajustar según sea necesario

# Auth credentials para pruebas
EXPO_PUBLIC_CLIENT_ID=demo-client
EXPO_PUBLIC_CLIENT_SECRET=demo-secret-key-2026

# Proxy backend (asume servidor local en 192.168.1.10:3000)
EXPO_PUBLIC_PROXY_BASE_URL=http://192.168.1.10:3000

# Dev token para categorización
EXPO_PUBLIC_DEV_AUTH_TOKEN=dev-token-2026

# Gemini API (opcional, para IA)
EXPO_PUBLIC_GEMINI_API_URL=
