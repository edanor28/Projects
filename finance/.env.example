# Example environment variables (do NOT commit real keys)
# Gemini (AI) API
GEMINI_API_URL=https://api.gemini.example/v1/infer
GEMINI_API_KEY=your_gemini_api_key_here

# Open Banking / GoCardless
OPEN_BANKING_CLIENT_ID=replace_me
OPEN_BANKING_CLIENT_SECRET=replace_me

# Optional: backend proxy (recommended) - do NOT expose secrets here.
PROXY_BASE_URL=http://localhost:3000
